{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ugcv2:visual:v1",
  "title": "UGCv2 - storyboard d'illustrations originales",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_url", "width", "height", "fps", "scenes"],
  "properties": {
    "schema": {"const": "ugcv2.visual.v1"},
    "source_url": {"type": "string", "format": "uri"},
    "width": {"const": 1920},
    "height": {"const": 1080},
    "fps": {"const": 30},
    "transition_s": {"type": "number", "minimum": 0, "maximum": 0.8},
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "template", "duration_s", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,48}$"},
          "template": {"enum": ["hook", "workflow", "interface", "chart", "recap"]},
          "duration_s": {"type": "number", "minimum": 0.9, "maximum": 60},
          "title": {"type": "string", "minLength": 1, "maxLength": 85},
          "eyebrow": {"type": "string", "maxLength": 36},
          "narration": {"type": "string", "maxLength": 1500},
          "camera": {"enum": ["none", "push_in", "pan"]},
          "messages": {"$ref": "#/$defs/items"},
          "count": {"type": "integer", "minimum": 1, "maximum": 99},
          "nodes": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "maxLength": 38}},
          "request": {"type": "string", "minLength": 1, "maxLength": 210},
          "category": {"type": "string", "minLength": 1, "maxLength": 32},
          "draft": {"type": "string", "minLength": 1, "maxLength": 210},
          "city": {"type": "string", "maxLength": 32},
          "note": {"type": "string", "maxLength": 110},
          "unit": {"type": "string", "maxLength": 90},
          "items": {"$ref": "#/$defs/items"},
          "bars": {
            "type": "array", "minItems": 1, "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["label", "value"],
              "properties": {
                "label": {"type": "string", "maxLength": 25},
                "value": {"type": "number", "minimum": 0, "maximum": 1000000}
              }
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"template": {"const": "hook"}}}, "then": {"required": ["messages"]}},
          {"if": {"properties": {"template": {"const": "workflow"}}}, "then": {"required": ["nodes"]}},
          {"if": {"properties": {"template": {"const": "interface"}}}, "then": {"required": ["request", "category", "draft"]}},
          {"if": {"properties": {"template": {"const": "chart"}}}, "then": {"required": ["bars"]}},
          {"if": {"properties": {"template": {"const": "recap"}}}, "then": {"required": ["items"]}}
        ]
      }
    }
  },
  "$defs": {
    "items": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "maxLength": 38}}
  },
  "$comment": "Le validateur Python vérifie aussi les identifiants uniques, la durée supérieure à deux transitions, les champs par template et les limites de texte mesurées avec la vraie police. Aucun média externe n'est accepté."
}
