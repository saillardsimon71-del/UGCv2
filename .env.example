# Studio UGC v2 — copier en .env (aucune valeur obligatoire pour démarrer)
STUDIO_HOST=0.0.0.0
STUDIO_PORT=8000
STUDIO_MAX_WORKERS=1
# 1 = plaques SIMULATION autorisées quand aucun GPU (atelier/tests).
# 0 = production client : un job échoue au lieu de simuler.
STUDIO_ALLOW_MOCK=1
# --- Modal (vrais rendus GPU) ---
STUDIO_MODAL_ENABLED=0
STUDIO_MODAL_WORKSPACE=lucj76861
# Apps déjà prouvées sur votre compte (ne pas changer sans raison) :
STUDIO_MODAL_APP_VIDEO=pvs-ltx
STUDIO_MODAL_APP_AVATAR=pvs-longcat-avatar
# Nouvelles apps UGCv2 (deploy/modal_*_worker.py) :
STUDIO_MODAL_APP_FACE=ugc-face
STUDIO_MODAL_APP_PERF=ugc-perf
STUDIO_MODAL_APP_LIPSYNC=ugc-lipsync
STUDIO_MODAL_APP_VOICE=ugc-voice
STUDIO_MODAL_APP_TALK=ugc-talk
# --- Directeur créatif LLM (optionnel ; sinon gabarits locaux FR) ---
# STUDIO_LLM_BASE_URL=https://api.deepseek.com/v1
# STUDIO_LLM_MODEL=deepseek-chat
# STUDIO_LLM_API_KEY=
